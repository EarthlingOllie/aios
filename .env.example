# Copy to .env (used by docker compose). For `pnpm dev` use PUBLIC_URL=http://localhost:5173.
PUBLIC_URL=http://localhost:8080

SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# GitHub OAuth app: callback URL must be ${PUBLIC_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=voyageai:voyage-4

# run_python sandboxes (docker compose runs the broker). runc works without gVisor but isolates
# nothing (development only); use runsc where gVisor is installed. Change the secrets for
# anything shared.
SANDBOX_DOCKER_RUNTIME=runc
SANDBOX_BROKER_TOKEN=dev-broker-token
SANDBOX_PROXY_SECRET=dev-proxy-secret
