# Copy to .env (used by docker compose). For `pnpm dev` use PUBLIC_URL=http://localhost:5173.
PUBLIC_URL=http://localhost:8080

# People register and sign in with an email and password (no third-party sign-in). The session
# is a cookie signed with this.
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts data stores' passwords; changing it makes existing stores' unreadable.
DATA_STORE_CREDENTIALS_KEY=change-me-to-another-long-random-string
COOKIE_SECURE=false
# docker compose turns on DEV_LOGIN_ENABLED (the sign-in page's "sign in as" picker) itself.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=voyageai:voyage-4

# run_python: docker compose sets the api's SANDBOX_* variables itself, pointing it at the
# `sandbox` service (SANDBOX_BACKEND=dev: one shared, unisolated runner, for development only).
# On AWS, Terraform sets SANDBOX_BACKEND=fargate and the rest.

# Optional: trace agent runs to a (self-hosted) Langfuse instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
