# Copy to .env (used by docker compose). For `pnpm dev` use PUBLIC_URL=http://localhost:5173.
PUBLIC_URL=http://localhost:8080

SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# GitHub OAuth app: callback URL must be ${PUBLIC_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=voyageai:voyage-4
