# Copy to .env for local (non-docker) runs. docker-compose sets the infra URLs itself.
PUBLIC_URL=http://localhost:5173
# The app's role, which `uv run python -m aios.db_roles` creates as the master user (Compose's
# `aios`). Only that command reads DATABASE_ADMIN_URL; the provisioner's role creates and
# migrates data stores (the provisioning worker).
DATABASE_URL=postgresql+psycopg://aios_app:aios_app@localhost:5432/aios
DATA_STORE_PROVISIONER_URL=postgresql+psycopg://aios_provisioner:aios_provisioner@localhost:5432/aios
DATABASE_ADMIN_URL=postgresql+psycopg://aios:aios@localhost:5432/aios
REDIS_URL=redis://localhost:6379/0
# Uploaded files: Compose's RustFS (`docker compose up -d rustfs`), standing in for S3. Make the
# bucket once with `uv run python -m aios.datastores.files create-bucket`.
DATA_STORE_FILES_ENDPOINT=http://localhost:9000
DATA_STORE_FILES_ACCESS_KEY=rustfsadmin
DATA_STORE_FILES_SECRET_KEY=rustfsadmin
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts data stores' passwords; changing it makes existing stores' unreadable.
DATA_STORE_CREDENTIALS_KEY=change-me-to-another-long-random-string
COOKIE_SECURE=false

# GitHub OAuth app: callback URL must be ${PUBLIC_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=voyageai:voyage-4

# run_python: with no backend the tool tells the model it isn't available. For local runs, start
# the shared dev sandbox (`docker compose up -d sandbox`, unisolated: development only) and set:
# SANDBOX_BACKEND=dev
# SANDBOX_DEV_URL=http://localhost:8081
# SANDBOX_DEV_TOKEN=dev-sandbox-token
